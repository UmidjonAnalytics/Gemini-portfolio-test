rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if true; // Public can read images/PDFs
      allow write: if isAdmin(); // Only admin can upload/delete
    }
  }
}
